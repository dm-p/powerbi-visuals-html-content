{
    "compilerOptions": {
        "allowJs": false,
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true,
        "module": "es6",
        "target": "es6",
        "sourceMap": true,
        "outDir": "./.tmp/build/",
        "rootDir": ".",
        "moduleResolution": "bundler",
        "declaration": true,
        "lib": ["es2019", "dom"],
        "strict": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "resolveJsonModule": true
    },
    "files": ["./src/visual.ts", "./src/svg.d.ts"],
    "include": ["./src/**/*.ts"]
}
